{
  "name": "career-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch server/dev.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:fixture-maintenance": "node --import tsx --test tests/maintenance/technical-fixture.test.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "verify:local": "node scripts/verify-local.mjs",
    "db:local:apply": "tsx scripts/local-db.ts apply",
    "db:local:check": "tsx scripts/local-db.ts check",
    "owner:provision:local": "tsx scripts/provision-owner.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "export:private": "tsx scripts/export-private.ts",
    "restore:private": "tsx scripts/restore-private.ts",
    "publication:check": "tsx scripts/publication-check.ts",
    "build:check": "tsx scripts/check-build.ts && node scripts/check-api-runtime.mjs",
    "cutover:check": "tsx scripts/cutover-check.ts",
    "agent": "tsx scripts/agent-client.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "csv-parse": "7.0.3",
    "echarts": "6.1.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.18.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/routing-utils": "6.6.1",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
