# Navegador: apenas URL e chave publicável; nunca adicionar segredos com prefixo VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor: manter em ambiente local ignorado pelo Git. Não usar dados reais no desenvolvimento.
DATABASE_URL=
OWNER_USER_ID=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Produção: verify-full, transaction, URL do pooler com usuário career_api.<referência>.
# Teste local explícito: NODE_ENV=test e DATABASE_TLS=disable-local.
DATABASE_TLS=verify-full
DATABASE_POOL_MODE=transaction
DATABASE_POOL_MAX=3
# Vercel Node: desativar helpers para limitar o stream bruto antes do JSON.parse.
NODEJS_HELPERS=0
# Opcional: certificado CA PEM, sem desativar a validação de hostname/cadeia.
DATABASE_CA_CERT=

# Comandos db:local:* aceitam somente loopback e o banco dedicado career_tracker_test.
# Exemplo de formato (substituir a senha local):
# postgresql://postgres:SENHA_LOCAL@127.0.0.1:54322/career_tracker_test
LOCAL_TEST_DATABASE_URL=

# Provisionamento temporário: preencher somente durante essa operação e remover depois.
# Nunca importar estas variáveis no frontend ou persistir credenciais no repositório.
SUPABASE_SECRET_KEY=
OWNER_INITIAL_PASSWORD=
# Provisionamento local da etapa 3: duas senhas distintas, 24–128 caracteres ASCII sem espaços.
# LOCAL_TEST_DATABASE_URL é administrativa; DATABASE_URL da aplicação usa somente career_api.
CAREER_API_PASSWORD=
CAREER_RESTORE_PASSWORD=
